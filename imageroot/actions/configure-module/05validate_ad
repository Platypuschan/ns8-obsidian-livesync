# Check the AD domain and group before anything is changed.

import json
import os
import sys

import agent

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "pypkg"))
import livesync_ad

agent.set_weight(os.path.basename(__file__), 0)

data = json.load(sys.stdin)
if not data.get("ad_enabled"):
    sys.exit(0)


def fail(field, value, error):
    agent.set_status("validation-failed")
    json.dump([{"field": field, "parameter": field, "value": value, "error": error}], fp=sys.stdout)
    sys.exit(2)


domain = (data.get("ad_domain") or "").strip()
group = (data.get("ad_group") or "").strip()
if not domain:
    fail("ad_domain", domain, "ad_domain_required")
if not group:
    fail("ad_group", group, "ad_group_required")
try:
    livesync_ad.domain_settings(domain)
except livesync_ad.ADError:
    fail("ad_domain", domain, "ad_domain_unavailable")

# Bind the domain before querying it; restore the previous binding if the
# group cannot be read, so a rejected request changes nothing.
previous = os.environ.get("LIVESYNC_AD_DOMAIN", "")
agent.bind_user_domains([domain])
try:
    livesync_ad.group_members(domain, group, bool(data.get("ad_nested_groups")))
except livesync_ad.ADError as error:
    agent.bind_user_domains([previous] if previous else [])
    print(error, file=sys.stderr)
    fail("ad_group", group, "ad_group_not_found")
