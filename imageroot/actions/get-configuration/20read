import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "pypkg"))
import livesync_setup

host = os.getenv("TRAEFIK_HOST", "")
username, password = livesync_setup.read_sync_credentials()
config = {
    "host": host,
    "http2https": os.getenv("TRAEFIK_HTTP2HTTPS") == "True",
    "lets_encrypt": os.getenv("TRAEFIK_LETS_ENCRYPT") == "True",
    "database": os.getenv("LIVESYNC_DATABASE", livesync_setup.DEFAULT_DATABASE),
    # Obsidian on mobile devices only connects over HTTPS.
    "url": f"https://{host}" if host else "",
    "username": username,
    "password": password,
}

json.dump(config, fp=sys.stdout)
