{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Get Obsidian LiveSync settings",
    "$id": "http://nethserver.org/json-schema/task/output/obsidian-livesync/get-configuration",
    "description": "Get Obsidian LiveSync settings and the connection data for the plugin",
    "examples": [
        {
            "host": "livesync.domain.org",
            "http2https": true,
            "lets_encrypt": true,
            "url": "https://livesync.domain.org",
            "accounts": [
                {
                    "username": "livesync",
                    "password": "secret",
                    "database": "obsidiannotes"
                }
            ]
        }
    ],
    "type": "object",
    "required": [
        "host",
        "http2https",
        "lets_encrypt",
        "url",
        "accounts"
    ],
    "properties": {
        "host": {
            "type": "string",
            "description": "Host name for the server, like 'livesync.domain.org'"
        },
        "lets_encrypt": {
            "type": "boolean"
        },
        "http2https": {
            "type": "boolean"
        },
        "url": {
            "type": "string",
            "description": "Server URI to enter in the plugin; empty before the first configuration"
        },
        "accounts": {
            "type": "array",
            "description": "Sync accounts, each with a database of its own",
            "items": {
                "type": "object",
                "required": [
                    "username",
                    "password",
                    "database"
                ],
                "properties": {
                    "username": {
                        "type": "string"
                    },
                    "password": {
                        "type": "string"
                    },
                    "database": {
                        "type": "string"
                    }
                }
            }
        }
    }
}
