# Delete an account's database and give the account a new, empty one with
# the same name. The Obsidian clients must then upload their vault again.

import json
import os
import sys

import agent

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "pypkg"))
import livesync_setup

username = json.load(sys.stdin)["username"]

client = livesync_setup.CouchDB(
    "http://127.0.0.1:" + os.environ["TCP_PORT"], *livesync_setup.ensure_admin_credentials()
)
with livesync_setup.accounts_lock():
    accounts = livesync_setup.ensure_accounts(os.environ.get("LIVESYNC_DATABASE"))
    account = next((item for item in accounts if item["username"] == username), None)
    if account is None or not livesync_setup.is_enabled(account):
        agent.set_status("validation-failed")
        error = "username_not_found" if account is None else "account_disabled"
        json.dump([{"field": "username", "parameter": "username", "value": username, "error": error}], fp=sys.stdout)
        sys.exit(2)
    try:
        livesync_setup.wait_until_up(client)
        livesync_setup.reset_database(client, account)
    except livesync_setup.ProvisioningError as error:
        print(error, file=sys.stderr)
        sys.exit(1)
