# Release 0.1.0 stored its single sync account in sync.env; move it into the
# account list. The CouchDB user and database already exist.

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "pypkg"))
import livesync_setup

state_dir = os.environ.get("AGENT_STATE_DIR", ".")
with livesync_setup.accounts_lock(state_dir):
    livesync_setup.migrate_legacy_account(os.environ.get("LIVESYNC_DATABASE"), state_dir)
