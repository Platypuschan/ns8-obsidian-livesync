{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "automerge": false,
  "dependencyDashboard": true,
  "rebaseWhen": "behind-base-branch",
  "prConcurrentLimit": 2,
  "prHourlyLimit": 2,
  "lockFileMaintenance": {"enabled": true},
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^build-images\\.sh$/"],
      "matchStrings": ["COUCHDB_TAG=\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "couchdb",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^build-images\\.sh$/"],
      "matchStrings": ["NODE_IMAGE=\"docker.io/library/node:(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "node",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/validate\\.yml$/"],
      "matchStrings": ["(?<depName>PyYAML|ldap3)==(?<currentValue>[0-9.]+)"],
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^test-module\\.sh$/"],
      "matchStrings": ["RUNNER_IMAGE=\"(?<depName>ghcr.io/marketsquare/robotframework-browser/rfbrowser-stable):(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^test-module\\.sh$/"],
      "matchStrings": ["(?<depName>robotframework-sshlibrary)==(?<currentValue>[0-9.]+)"],
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "description": "Bound CI churn; leave setup-node inputs to the Node group",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action", "workflow", "github-runner"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Keep production builder, dev image and CI on the tested Corepack-capable major",
      "matchPackageNames": ["node", "actions/node-versions"],
      "groupName": "Node.js toolchain",
      "allowedVersions": "<25"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "UI dependencies (non-major)",
      "groupSlug": "ui-dependencies-non-major"
    },
    {
      "description": "Every image input, including lockfile-only maintenance, needs a new module release",
      "matchFileNames": ["ui/**", "build-images.sh"],
      "bumpVersions": [
        {
          "name": "Module release version",
          "filePatterns": ["CATALOG_VERSION"],
          "matchStrings": ["^(?<version>[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?)\\s*$"],
          "bumpType": "patch"
        }
      ]
    },
    {
      "description": "CI-only actions: automerge non-major once the required checks pass",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action", "workflow", "github-runner"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "automerge": true
    },
    {
      "description": "CouchDB patch releases merge themselves after the full QEMU suite; minor stays manual because a merge publishes a catalog version",
      "matchPackageNames": ["couchdb"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Test tooling that is not shipped in the module image",
      "matchPackageNames": ["ghcr.io/marketsquare/robotframework-browser/rfbrowser-stable", "ghcr.io/renovatebot/renovate", "robotframework-sshlibrary", "PyYAML", "ldap3"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false
    }
  ]
}
